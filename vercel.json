{
  "rewrites": [
    { "source": "/api/vistos",        "destination": "/api/estado?tipo=vistos" },
    { "source": "/api/oportunidades", "destination": "/api/estado?tipo=oportunidades" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/public/index.html" }
  ]
}
